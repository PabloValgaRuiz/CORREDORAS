#Quiero hacer un archivo csv donde tenga cada una de mis muestras con carbones, sus profundidades compuestas y las edades
#necesito: (1) el archivo de las profundidades, (2) el de las edades y (3) una columna comun con el mismo nombre
library(readxl)
library(dplyr)
library(ggplot2)
TRAM20_core_depth_v4 <- read_xlsx("E:/Saco/IJP/1_data/Tramacastilla/depth/TRAM20/TRAM20_core_depth_v4.xlsx")
TRAM20_composite_depth <- TRAM20_core_depth_v4 %>%
select(c(2:8, 7)) %>%
mutate(site = ifelse(site == "TRAMACASTILLA", "TRAM20")) %>%
mutate(SampleId = paste(site, core, section, `cm range`, sep = "-")) %>% #concateno varias columnas para crear la columna SampleId
relocate(SampleId, .before = site) %>%
mutate(composite_depth = floor(`composite depth (cm)`)) %>% #con esto me quito los decimales
select(SampleId, composite_depth)
#ahora quiero un dataframe que tenga SampleId, composite depth, y las edades
TRAM20_bacon_ages <- read.table("E:/Saco/IJP/1_data/Tramacastilla/chrono/TRAM20/Bacon_runs/tram20.v5/tram20.v5_51_ages.txt", header = TRUE, sep = "\t")
TRAM20_age_depth <- TRAM20_bacon_ages %>%
mutate(composite_depth = floor(depth)) %>%
merge(TRAM20_composite_depth, by = "composite_depth") %>%
relocate(SampleId, .before = "composite_depth")
##### 1.1. Obtain sedimentation rate #####
TRAM20_age_depth <- TRAM20_age_depth %>%
rename("age" = "median")
TRAM20_age_depth %>%
ggplot(aes(x = age, y = depth)) +
geom_line() +
scale_y_reverse()
#calculate sedimentation rate (yrs/cm)
TRAM20_age_depth_sed_rate <- TRAM20_age_depth %>%
mutate(depth_diff = c(NA, diff(depth)),
age_diff = c(NA, diff(age)),
sed_rate = age_diff/depth_diff)
TRAM20_age_depth_sed_rate %>%
ggplot(aes(x = age, y = sed_rate)) +
geom_line() +
geom_point()
#mean sedimentation rate (yrs/cm) for charcoal samples (3U and 4U)
mean(TRAM20_age_depth_sed_rate[2:207,10])
sd(TRAM20_age_depth_sed_rate[2:207,10])
write.table(TRAM20_age_depth, "E:/Saco/IJP/1_data/Tramacastilla/depth/TRAM20/TRAM20_composite_depth_ages_v3.csv", sep = ",", row.names = F)
save.image("E:/Saco/IJP/2_code/tramacastilla_chrono/tram20_depth_age_v2.RData")
packages <- c("readxl", "dplyr", "tidyverse", "patchwork", "rioja", "vegan", "stringr",
"janitor", "Bchron", "RRatepol", "scales", "tidyr", "lattice", "ggplot2",
"cowplot", "tapas", "nlme", "paletteer", "mgcv", "factoextra", "ggrepel",
"grid", "corrplot", "psych") #RRatepol only works with R 4.2.0
lapply(packages, library, character.only = TRUE)
